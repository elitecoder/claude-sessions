    font: inherit;
  }
  header .hidden-toggle:hover { color: var(--fg); border-color: var(--accent-dim); }
  header .hidden-toggle.active { color: var(--accent); border-color: var(--accent); background: rgba(122,162,247,0.08); }
  main { padding: 20px 32px 40px; display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 16px; }
