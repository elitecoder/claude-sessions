#!/usr/bin/env python3
"""
claude-dashboard — HTTP server that renders a live dashboard of Claude sessions
and resumes any of them in a newly-created, correctly-named cmux workspace.

Endpoints:
  GET  /                 → dashboard HTML (cards, client-side polling)
  GET  /api/sessions     → JSON list of sessions with titles, cwds, previews
  POST /api/resume       → {session_id} creates a cmux workspace and resumes it
  GET  /healthz          → ok

Serves on 127.0.0.1:<CLAUDE_DASHBOARD_PORT>  (default 18577).
"""
import datetime
import glob
import html
import json
import os
import re
import shlex
import subprocess
import sys
import time
import traceback
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("CLAUDE_DASHBOARD_PORT") or os.environ.get("CMUX_DASHBOARD_PORT") or "18577")
SESSIONS_DIR = os.path.expanduser("~/.claude/projects")
REGISTRY = os.path.expanduser("~/.claude/cmux-registry.json")
HIDDEN_STORE = os.path.expanduser("~/.claude/cmux-dashboard-hidden.json")
EMBED_DB = os.path.expanduser("~/.claude/cmux-dashboard-embeddings.sqlite")
CMUX = "/Applications/cmux.app/Contents/Resources/bin/cmux"
HOME = os.path.expanduser("~")
# Hard cap for runaway safety only; normal corpora up to several thousand render fine
# thanks to the mtime-keyed parse cache below.
MAX_SESSIONS = int(os.environ.get("CLAUDE_DASHBOARD_MAX") or "5000")
# Semantic-search provider. "off" disables semantic entirely (no network calls,
# no sqlite open). "ollama" talks to a local Ollama daemon at OLLAMA_HOST
# (default http://127.0.0.1:11434). "openai" hits OpenAI's /v1/embeddings.
EMBED_PROVIDER = os.environ.get("CLAUDE_DASHBOARD_EMBED", "off").lower()
# Per-provider knobs. Defaults match the providers' own defaults.
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
OLLAMA_EMBED_MODEL = os.environ.get("CLAUDE_DASHBOARD_EMBED_MODEL", "nomic-embed-text")
OPENAI_EMBED_MODEL = os.environ.get("CLAUDE_DASHBOARD_EMBED_MODEL", "text-embedding-3-small")
OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY", "")
# How many tokens of session-summary text to embed. Just the title + first user
# prompt + last user prompt + last assistant reply — enough to capture topic
# without paying for the full transcript. Mirrors Scout's lesson: keep the
# embedding shape simple and let the lexical retrievers handle precision.
EMBED_DOC_MAX_CHARS = 4000

# In-memory cache: path -> (mtime_at_parse, parsed_dict).
# Survives the daemon's lifetime. Each JSONL is parsed once, then re-parsed only
# when its mtime changes (i.e., the session got new messages).
_PARSE_CACHE = {}
_PARSE_CACHE_LOCK = __import__("threading").Lock()

# Short-TTL cache of the filesystem scan. Enumerating + stat'ing every JSONL
# under ~/.claude/projects is the real cost on corpora of thousands of files
# (seconds on cold FS cache). The browser polls /api/sessions every 10s, so
# anything tighter than that wastes work — cache for a few seconds and let
# the next poll pay the scan cost.
_FSLIST_CACHE = None           # (timestamp, [(path, mtime), ...])
_FSLIST_CACHE_LOCK = __import__("threading").Lock()
FSLIST_TTL_SECONDS = 3.0

# Deep-search haystack cache: path -> (mtime, lowercased_text). Built lazily
# on first deep query; cached by mtime like the parse cache. We only keep the
# lowercased form and re-derive the snippet from file contents at render time
# (there are at most len(sessions) snippets per response, so it's cheap).
_HAYSTACK_CACHE = {}
_HAYSTACK_CACHE_LOCK = __import__("threading").Lock()
# Per-session haystack cap — keeps memory bounded on giant transcripts.
HAYSTACK_MAX_CHARS = 1_000_000
# Thread pool used to build haystacks in parallel for deep search. File I/O
# drops the GIL, so even with CPython this gives a real speedup on cold cache.
_HAYSTACK_POOL = None
_HAYSTACK_POOL_LOCK = __import__("threading").Lock()


def _haystack_pool():
    global _HAYSTACK_POOL
    if _HAYSTACK_POOL is not None:
        return _HAYSTACK_POOL
    with _HAYSTACK_POOL_LOCK:
        if _HAYSTACK_POOL is None:
            from concurrent.futures import ThreadPoolExecutor
            _HAYSTACK_POOL = ThreadPoolExecutor(
                max_workers=16, thread_name_prefix="haystack"
            )
    return _HAYSTACK_POOL


# ---- Semantic search (optional) -------------------------------------------
#
# Inspired by the public design of Adobe's Scout (https://github.com/Adobe-AIFoundations/scout):
# every embedding is content-hashed and cached in a sqlite K/V store, lookups
# are an array dot-product (no vector DB), and semantic results are fused with
# the existing lexical retrievers via Reciprocal Rank Fusion. The model and
# wire format are public providers (Ollama / OpenAI), not Scout's, so this
# adds zero new pip dependencies and zero new binaries.

_EMBED_CONN = None
_EMBED_CONN_LOCK = __import__("threading").Lock()
_EMBED_INDEX = None  # (sess_id_list, mtime_list, vectors_2d) — built on demand
_EMBED_INDEX_LOCK = __import__("threading").Lock()


def _embed_db():
    """Open (and lazily migrate) the embedding cache. Schema: one row per
    (provider, model, content_hash) -> raw float32 bytes."""
    global _EMBED_CONN
    if _EMBED_CONN is not None:
        return _EMBED_CONN
    with _EMBED_CONN_LOCK:
        if _EMBED_CONN is None:
            import sqlite3
            os.makedirs(os.path.dirname(EMBED_DB), exist_ok=True)
            conn = sqlite3.connect(EMBED_DB, check_same_thread=False)
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("""
                CREATE TABLE IF NOT EXISTS embeddings (
                    provider TEXT NOT NULL,
                    model    TEXT NOT NULL,
                    chash    TEXT NOT NULL,
                    dim      INTEGER NOT NULL,
                    vec      BLOB NOT NULL,
                    PRIMARY KEY (provider, model, chash)
                )
            """)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS sessions (
                    sess     TEXT PRIMARY KEY,
                    mtime    REAL NOT NULL,
                    chash    TEXT NOT NULL
                )
            """)
            conn.commit()
            _EMBED_CONN = conn
    return _EMBED_CONN


def _embed_doc_for(s):
    """Build the short summary string we actually send to the embedder. Title
    first (highest signal), then kickoff prompt, last user prompt, last reply.
    Capped at EMBED_DOC_MAX_CHARS so a giant transcript can't blow the model
    context window."""
    parts = []
    if s.get("ai_title"):
        parts.append(s["ai_title"])
    if s.get("first_user"):
        parts.append(s["first_user"])
    if s.get("last_user") and s.get("last_user") != s.get("first_user"):
        parts.append(s["last_user"])
    if s.get("last_assistant"):
        parts.append(s["last_assistant"])
    text = "\n".join(parts)
    if len(text) > EMBED_DOC_MAX_CHARS:
        text = text[:EMBED_DOC_MAX_CHARS]
    return text


def _embed_provider_id():
    """Return (provider, model) currently configured, or (None, None) if off."""
    if EMBED_PROVIDER == "ollama":
        return ("ollama", OLLAMA_EMBED_MODEL)
    if EMBED_PROVIDER == "openai":
        return ("openai", OPENAI_EMBED_MODEL)
    return (None, None)


def _embed_call(texts):
    """Call the configured provider with a list of strings. Returns a list of
    list[float]. Raises on transport errors so the caller can decide whether
    to surface a partial result."""
    import urllib.request, urllib.error
    provider, model = _embed_provider_id()
    if not provider:
        return [None] * len(texts)
    if provider == "ollama":
        out = []
        for t in texts:
            req = urllib.request.Request(
                f"{OLLAMA_HOST}/api/embeddings",
                data=json.dumps({"model": model, "prompt": t}).encode("utf-8"),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=30) as r:
                resp = json.loads(r.read())
            vec = resp.get("embedding")
            if not vec:
                raise RuntimeError(f"ollama returned no embedding: {resp}")
            out.append(vec)
        return out
    if provider == "openai":
        if not OPENAI_API_KEY:
            raise RuntimeError("OPENAI_API_KEY not set")
        req = urllib.request.Request(
            "https://api.openai.com/v1/embeddings",
            data=json.dumps({"model": model, "input": texts}).encode("utf-8"),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {OPENAI_API_KEY}",
            },
        )
        with urllib.request.urlopen(req, timeout=60) as r:
            resp = json.loads(r.read())
        return [d["embedding"] for d in resp.get("data", [])]
    raise RuntimeError(f"unknown embed provider: {provider}")


def _embed_lookup(provider, model, chash):
    """Cache lookup. Returns a list[float] or None."""
    import struct
    cur = _embed_db().execute(
        "SELECT dim, vec FROM embeddings WHERE provider=? AND model=? AND chash=?",
        (provider, model, chash),
    )
    row = cur.fetchone()
    if not row:
        return None
    dim, blob = row
    return list(struct.unpack(f"{dim}f", blob))


def _embed_store(provider, model, chash, vec):
    """Cache write. Stores raw float32 bytes — compact and fast to load."""
    import struct
    blob = struct.pack(f"{len(vec)}f", *vec)
    with _EMBED_CONN_LOCK:
        _embed_db().execute(
            "INSERT OR REPLACE INTO embeddings (provider, model, chash, dim, vec) VALUES (?,?,?,?,?)",
            (provider, model, chash, len(vec), blob),
        )
        _embed_db().commit()


def _content_hash(text):
    import hashlib
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def _lookup_session_embeddings(sessions):
    """Cache-only lookup. Never embeds, never blocks on the network. Returns
    (out, embeddable_count): out maps sess_id -> list[float] for cache hits,
    and embeddable_count is the number of sessions that *could* be embedded
    (have a non-empty summary doc). Used on the request path so search
    latency is bounded by sqlite + cosine, never by Ollama."""
    provider, model = _embed_provider_id()
    if not provider:
        return {}, 0
    out = {}
    embeddable = 0
    for s in sessions:
        doc = _embed_doc_for(s)
        if not doc:
            continue
        embeddable += 1
        chash = _content_hash(f"{provider}\n{model}\n{doc}")
        cached = _embed_lookup(provider, model, chash)
        if cached:
            out[s["sess"]] = cached
    return out, embeddable


def _ensure_session_embeddings(sessions, parallelism=8):
    """Synchronously fill any missing embeddings. Used by the explicit
    /api/embed/reindex endpoint and the startup warmer. Not on the request
    hot path — that goes through _lookup_session_embeddings instead."""
    provider, model = _embed_provider_id()
    if not provider:
        return {}
    todo = []
    out = {}
    for s in sessions:
        doc = _embed_doc_for(s)
        if not doc:
            continue
        chash = _content_hash(f"{provider}\n{model}\n{doc}")
        cached = _embed_lookup(provider, model, chash)
        if cached:
            out[s["sess"]] = cached
        else:
            todo.append((s["sess"], doc, chash))

    if not todo:
        return out

    from concurrent.futures import ThreadPoolExecutor
    def _one(item):
        sess, doc, chash = item
        vecs = _embed_call([doc])
        return sess, chash, vecs[0]

    with ThreadPoolExecutor(max_workers=parallelism, thread_name_prefix="embed") as ex:
        for fut in ex.map(_one, todo):
            sess, chash, vec = fut
            _embed_store(provider, model, chash, vec)
            out[sess] = vec
    return out


# Background warmer: a single long-lived worker that keeps the embedding
# cache hot. Triggered from build_payload() when a request notices missing
# embeddings, and once at daemon startup. Coalesced — only one warm runs at
# a time; concurrent triggers just mark "needs another pass" and the worker
# does it after the current pass finishes.
_WARMER_THREAD = None
_WARMER_TRIGGER = __import__("threading").Event()
_WARMER_BUSY = False
_WARMER_LOCK = __import__("threading").Lock()
_WARMER_LAST_RUN = 0.0
_WARMER_LAST_DURATION = 0.0
_WARMER_LAST_FILLED = 0
# Exponential moving average of seconds-per-embedding across warmer passes.
# Lets the UI compute a useful ETA on the first run when no other signal
# exists; updated on every pass that actually filled at least one slot.
_WARMER_SEC_PER_EMBED = 0.0


def _warmer_loop():
    """Body of the background warmer thread. Sleeps on _WARMER_TRIGGER and
    runs _ensure_session_embeddings over the current session list. Errors
    are swallowed (provider down, network blip) — the next trigger retries.
    Also tracks throughput so the UI can show an honest ETA."""
    global _WARMER_BUSY, _WARMER_LAST_RUN, _WARMER_LAST_DURATION
    global _WARMER_LAST_FILLED, _WARMER_SEC_PER_EMBED
    while True:
        _WARMER_TRIGGER.wait()
        _WARMER_TRIGGER.clear()
        _WARMER_BUSY = True
        t0 = time.time()
        filled = 0
        try:
            sessions = collect_sessions()
            before = len(_lookup_session_embeddings(sessions)[0])
            _ensure_session_embeddings(sessions, parallelism=8)
            after = len(_lookup_session_embeddings(sessions)[0])
            filled = max(0, after - before)
        except Exception:
            traceback.print_exc()
        dur = time.time() - t0
        _WARMER_LAST_RUN = time.time()
        _WARMER_LAST_DURATION = dur
        _WARMER_LAST_FILLED = filled
        # Update the s/embed EMA only when the pass actually filled something —
        # zero-fill passes (no work to do) carry no information about throughput.
        if filled > 0 and dur > 0:
            sample = dur / filled
            if _WARMER_SEC_PER_EMBED <= 0:
                _WARMER_SEC_PER_EMBED = sample
            else:
                # Light EMA — 30% new, 70% old. Smooths out one-off spikes.
                _WARMER_SEC_PER_EMBED = 0.3 * sample + 0.7 * _WARMER_SEC_PER_EMBED
        _WARMER_BUSY = False


def _start_warmer_if_configured():
    """Spawn the background warmer once. No-op if no provider is set."""
    global _WARMER_THREAD
    if EMBED_PROVIDER == "off":
        return
    with _WARMER_LOCK:
        if _WARMER_THREAD is not None:
            return
        import threading
        _WARMER_THREAD = threading.Thread(
            target=_warmer_loop, name="embed-warmer", daemon=True
        )
        _WARMER_THREAD.start()
    # Kick a first pass right away.
    _WARMER_TRIGGER.set()


def _request_warm():
    """Idempotent nudge. Safe to call from any thread. Returns immediately."""
    if EMBED_PROVIDER == "off":
        return
    _start_warmer_if_configured()
    _WARMER_TRIGGER.set()


def _cosine(a, b):
    """Cosine similarity. Inputs are list[float]; returns a single float in
    [-1, 1]. No numpy dependency, but explicit element-wise sums keep it fast
    enough for ~500 sessions × ~768 dims (~50 ms total uncached, free cached
    via the index below)."""
    if not a or not b or len(a) != len(b):
        return 0.0
    dot = 0.0
    na = 0.0
    nb = 0.0
    for x, y in zip(a, b):
        dot += x * y
        na += x * x
        nb += y * y
    if na == 0.0 or nb == 0.0:
        return 0.0
    return dot / ((na ** 0.5) * (nb ** 0.5))


def _rrf_fuse(rankings, k=60):
    """Reciprocal Rank Fusion. `rankings` is a list of ranked-id lists, one
    per retriever. Returns dict sess_id -> fused_score. The classic Cormack
    et al. formula: score(d) = sum_r 1 / (k + rank_r(d)). k=60 is the
    standard default — small enough that top-1 dominates, large enough that
    middle ranks still contribute."""
    fused = {}
    for ranking in rankings:
        for rank, sess_id in enumerate(ranking, start=1):
            fused[sess_id] = fused.get(sess_id, 0.0) + 1.0 / (k + rank)
    return fused


def _extract_user_text(j):
    if j.get("type") != "user":
        return None
    msg = j.get("message", {})
    c = msg.get("content")
    if isinstance(c, list):
        c = " ".join(
            x.get("text", "") for x in c
            if isinstance(x, dict) and x.get("type") == "text"
        )
    if not isinstance(c, str):
        return None
    s = c.strip()
    if not s or s.startswith("<"):
        return None
    return s


def _extract_assistant_text(j):
    if j.get("type") != "assistant":
        return None
    c = j.get("message", {}).get("content")
    if isinstance(c, list):
        for x in c:
            if isinstance(x, dict) and x.get("type") == "text":
                t = x.get("text", "").strip()
                if t:
                    return t
    return None


def _condense(text):
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    while lines and (lines[0].startswith("#") or lines[0].lower() in ("## context", "context", "context:")):
        lines.pop(0)
    return " ".join(lines)


def _strip_code_fences(text):
    return re.sub(r"```[^`]*```", "[code]", text, flags=re.DOTALL)


def parse_session(path):
    """Parse a session JSONL, with per-file mtime-keyed caching.
    Re-reads only when the file has been modified since last parse."""
    try:
        mtime = os.path.getmtime(path)
    except OSError:
        return None
    with _PARSE_CACHE_LOCK:
        cached = _PARSE_CACHE.get(path)
        if cached and cached[0] == mtime:
            return cached[1]
    parsed = _parse_session_raw(path)
    if parsed is not None:
        parsed["mtime"] = mtime
        with _PARSE_CACHE_LOCK:
            _PARSE_CACHE[path] = (mtime, parsed)
    return parsed


def _parse_session_raw(path):
    sess = os.path.basename(path)[:-6]
    cwd = ""
    ai_title = ""
    first_user = ""
    last_user = ""
    last_assistant = ""
    last_user_ts = ""
    n_msgs = 0
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                n_msgs += 1
                t = j.get("type")
                if not cwd and j.get("cwd"):
                    cwd = j["cwd"]
                if t == "ai-title":
                    v = j.get("aiTitle") or j.get("title")
                    if isinstance(v, str) and v.strip():
                        ai_title = v.strip()
                    continue
                utxt = _extract_user_text(j)
                if utxt:
                    if not first_user:
                        first_user = _condense(utxt)
                    last_user = _condense(utxt)
                    ts = j.get("timestamp", "")
                    if ts:
                        last_user_ts = ts
                    continue
                atxt = _extract_assistant_text(j)
                if atxt:
                    last_assistant = _condense(_strip_code_fences(atxt))
    except Exception:
        pass
    return {
        "sess": sess,
        "cwd": cwd or "",
        "ai_title": ai_title,
        "first_user": first_user,
        "last_user": last_user,
        "last_assistant": last_assistant,
        "last_user_ts": last_user_ts,
        # mtime populated by the parse_session() wrapper
        "n_msgs": n_msgs,
    }


def humantime(ts):
    delta = datetime.datetime.now().timestamp() - ts
    if delta < 60: return f"{int(delta)}s"
    if delta < 3600: return f"{int(delta/60)}m"
    if delta < 86400: return f"{int(delta/3600)}h"
    return f"{int(delta/86400)}d"


def shorten_cwd(cwd, width=60):
    short = cwd.replace(HOME, "~") if cwd.startswith(HOME) else cwd
    if len(short) > width:
        short = "…" + short[-(width - 1):]
    return short


_HIDDEN_LOCK = __import__("threading").Lock()


def load_hidden():
    """Return set of session_ids the user has hidden from the dashboard."""
    try:
        with open(HIDDEN_STORE) as f:
            data = json.load(f)
        return set(data.get("hidden", []))
    except Exception:
        return set()


def save_hidden(ids):
    """Atomic write of the hidden set."""
    payload = {
        "hidden": sorted(ids),
        "updated_at": datetime.datetime.now().isoformat(timespec="seconds"),
    }
    tmp = HIDDEN_STORE + ".tmp"
    os.makedirs(os.path.dirname(HIDDEN_STORE), exist_ok=True)
    with open(tmp, "w") as f:
        json.dump(payload, f, indent=2)
    os.replace(tmp, HIDDEN_STORE)


def hide_session(sid):
    with _HIDDEN_LOCK:
        hidden = load_hidden()
        hidden.add(sid)
        save_hidden(hidden)
    return len(hidden)


def unhide_session(sid):
    with _HIDDEN_LOCK:
        hidden = load_hidden()
        hidden.discard(sid)
        save_hidden(hidden)
    return len(hidden)


def load_registry():
    try:
        with open(REGISTRY) as f:
            return json.load(f)
    except Exception:
        return {}


def live_workspaces():
    try:
        out = subprocess.run(
            [CMUX, "--json", "--id-format", "both", "list-workspaces"],
            capture_output=True, text=True, timeout=2,
        )
        if out.returncode != 0 or not out.stdout.strip():
            return {}
        data = json.loads(out.stdout)
        items = data.get("workspaces") if isinstance(data, dict) else data
        result = {}
        for w in items or []:
            wid = w.get("id") or w.get("uuid")
            if wid:
                result[wid] = {
                    "title": w.get("title") or "",
                    "ref": w.get("ref") or "",
                    "selected": bool(w.get("selected")),
                }
        return result
    except Exception:
        return {}


def active_session_ids(registry, ws_live):
    return {
        entry["session_id"]
        for ws, entry in registry.items()
        if ws in ws_live and entry.get("session_id")
    }


def _list_session_files():
    """Enumerate JSONL files and capture their mtimes. Cached with a short TTL
    so rapid-fire requests (browser poll + a manual search) share one scan."""
    global _FSLIST_CACHE
    now = time.time()
    with _FSLIST_CACHE_LOCK:
        if _FSLIST_CACHE and now - _FSLIST_CACHE[0] < FSLIST_TTL_SECONDS:
            return _FSLIST_CACHE[1]
    entries = []
    for p in glob.glob(os.path.join(SESSIONS_DIR, "*", "*.jsonl")):
        if "/subagents/" in p:
            continue
        try:
            entries.append((p, os.path.getmtime(p)))
        except OSError:
            pass
    entries.sort(key=lambda e: e[1], reverse=True)
    entries = entries[:MAX_SESSIONS]
    with _FSLIST_CACHE_LOCK:
        _FSLIST_CACHE = (now, entries)
    return entries


def collect_sessions():
    entries = _list_session_files()

    # Separate cache-hits from cache-misses. Hot paths use the mtime we just
    # captured; cold paths pay the parse cost.
    hot = {}
    cold = []
    for p, mtime in entries:
        with _PARSE_CACHE_LOCK:
            cached = _PARSE_CACHE.get(p)
        if cached and cached[0] == mtime:
            hot[p] = cached[1]
        else:
            cold.append(p)

    cold_parsed = {}
    if cold:
        pool = _haystack_pool()
        futures = {pool.submit(parse_session, p): p for p in cold}
        for f in futures:
            p = futures[f]
            try:
                cold_parsed[p] = f.result()
            except Exception:
                cold_parsed[p] = None

    parsed = []
    for p, _ in entries:
        s = hot.get(p) or cold_parsed.get(p)
        if s is not None:
            s["path"] = p
            parsed.append(s)
    return parsed


def _build_haystack(path):
    """Read a JSONL and produce a lowercased concatenation of user+assistant
    text, capped at HAYSTACK_MAX_CHARS. Returns '' on read errors."""
    chunks = []
    total = 0
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                t = _extract_user_text(j) or _extract_assistant_text(j)
                if not t:
                    continue
                chunks.append(t)
                total += len(t) + 1
                if total >= HAYSTACK_MAX_CHARS:
                    break
    except Exception:
        return ""
    return "\n".join(chunks).lower()


def _load_haystack(path):
    """Return the lowercased haystack for one path, using the mtime cache."""
    try:
        mtime = os.path.getmtime(path)
    except OSError:
        return ""
    with _HAYSTACK_CACHE_LOCK:
        cached = _HAYSTACK_CACHE.get(path)
        if cached and cached[0] == mtime:
            return cached[1]
    lower = _build_haystack(path)
    with _HAYSTACK_CACHE_LOCK:
        _HAYSTACK_CACHE[path] = (mtime, lower)
    return lower


def _warm_haystacks(paths):
    """Warm the haystack cache for a list of paths in parallel. Missing or
    stale entries are built via a thread pool so cold deep searches don't
    serialize on 2000+ sequential file reads."""
    todo = []
    for p in paths:
        try:
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        with _HAYSTACK_CACHE_LOCK:
            cached = _HAYSTACK_CACHE.get(p)
            if cached and cached[0] == mtime:
                continue
        todo.append(p)
    if not todo:
        return
    pool = _haystack_pool()
    futures = [pool.submit(_load_haystack, p) for p in todo]
    for f in futures:
        try:
            f.result()
        except Exception:
            pass


def _snippet_from_file(path, q_lower, width=140):
    """Read the JSONL and return a short snippet around the first hit, or ''.
    Called only for sessions we already know match (so at most the rendered
    count of files are opened per response)."""
    q_len = len(q_lower)
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                t = _extract_user_text(j) or _extract_assistant_text(j)
                if not t:
                    continue
                idx = t.lower().find(q_lower)
                if idx >= 0:
                    return _snippet_around(t, idx, q_len, width=width)
    except Exception:
        pass
    return ""


def _snippet_around(full, idx, q_len, width=140):
    """Return a short snippet centered on idx, with a leading/trailing ellipsis
    when truncated. Collapses runs of whitespace for readability."""
    half = max(0, (width - q_len) // 2)
    start = max(0, idx - half)
    end = min(len(full), idx + q_len + half)
    snippet = full[start:end]
    snippet = re.sub(r"\s+", " ", snippet).strip()
    if start > 0:
        snippet = "…" + snippet
    if end < len(full):
        snippet = snippet + "…"
    return snippet


def _match_shallow(s, q_lower):
    """Return (field_name, idx_in_preview) or None. Checks the cheap preview
    fields that the client already has — used server-side for consistent
    behavior when a query is supplied."""
    for field in ("ai_title", "first_user", "last_user", "last_assistant", "cwd"):
        v = s.get(field) or ""
        if not v:
            continue
        idx = v.lower().find(q_lower)
        if idx >= 0:
            return field, idx
    return None


def _match_deep(s, q_lower):
    """Full-transcript search. Returns a snippet string, or None.

    Lookup happens in two steps: a fast substring check against the cached
    lowercased haystack (already warmed by _warm_haystacks), and — only for
    hits — a second short scan of the file to produce a human-readable
    snippet from original-case text."""
    path = s.get("path")
    if not path:
        return None
    lower = _load_haystack(path)
    if not lower or q_lower not in lower:
        return None
    return _snippet_from_file(path, q_lower) or "(match)"


def build_payload(include_hidden=False, query="", deep=False):
    sessions = collect_sessions()
    registry = load_registry()
    ws_live = live_workspaces()
    active_ids = active_session_ids(registry, ws_live)
    hidden_ids = load_hidden()
    q_lower = (query or "").strip().lower()
    if q_lower and deep:
        # Parallel warm-up so 2000+ cold file reads don't serialize.
        _warm_haystacks([s["path"] for s in sessions if "path" in s])

    # Semantic retriever runs automatically whenever a provider is configured.
    # Cache-only on the request path: missing embeddings simply don't
    # contribute to the ranking this turn, and a background warmer fills them
    # for next time. Lexical search keeps working throughout.
    semantic_ranks = []
    semantic_error = ""
    semantic_used = False
    semantic_pending = 0
    semantic_indexed = 0
    semantic_total = 0
    if EMBED_PROVIDER != "off":
        try:
            embeds, embeddable = _lookup_session_embeddings(sessions)
            semantic_indexed = len(embeds)
            semantic_total = embeddable
            # Only sessions that *could* be embedded count as pending. Sessions
            # without any title/prompt/reply text (e.g. opened-then-closed
            # immediately) get skipped permanently and shouldn't make the
            # status pill say "indexing 6…" forever.
            semantic_pending = max(0, embeddable - len(embeds))
            if semantic_pending:
                _request_warm()
            if q_lower and embeds:
                qvec = _embed_call([query])[0]
                scored = [
                    (sid, _cosine(qvec, v)) for sid, v in embeds.items()
                ]
                scored.sort(key=lambda t: t[1], reverse=True)
                semantic_ranks = [sid for sid, _ in scored[:50]]
                semantic_used = bool(semantic_ranks)
        except Exception as e:
            semantic_error = str(e)

    # session_id -> (workspace_id, workspace_title)
    sess_to_ws = {}
    # workspace_id -> session_id (so UI can flag which live workspaces have a Claude running)
    ws_to_sess = {}
    for ws, entry in registry.items():
        if ws in ws_live and entry.get("session_id"):
            sess_to_ws[entry["session_id"]] = (ws, ws_live[ws]["title"])
            ws_to_sess[ws] = entry["session_id"]

    # List of live workspaces for the "resume into existing" picker
    workspaces_list = []
    for ws_id, info in ws_live.items():
        workspaces_list.append({
            "id": ws_id,
            "ref": info.get("ref", ""),
            "title": info.get("title", "") or "(untitled)",
            "selected": info.get("selected", False),
            "has_claude": ws_id in ws_to_sess,
        })
    # Stable sort: selected first, then by ref number
    def _ref_num(w):
        m = re.search(r"\d+", w["ref"] or "")
        return int(m.group()) if m else 9999
    workspaces_list.sort(key=lambda w: (not w["selected"], _ref_num(w)))

    # First pass: per-session lexical decision. We capture which retriever
    # contributed each candidate so RRF can fuse multiple rankings later.
    out = []
    hidden_count = 0
    deep_hits = 0
    shallow_rank = []     # ordered: matches before non-matches doesn't apply
                          # (we only emit matches), but we keep insertion order
                          # which is mtime-newest-first thanks to collect_sessions.
    deep_rank = []
    semantic_only_added = set()  # session ids added via semantic that weren't lexical hits

    by_sess = {}
    for s in sessions:
        is_hidden = s["sess"] in hidden_ids
        if is_hidden:
            hidden_count += 1
            if not include_hidden:
                continue

        snippet = ""
        matched_field = ""
        kept = False

        if not q_lower:
            kept = True
        else:
            shallow = _match_shallow(s, q_lower)
            if shallow:
                matched_field = shallow[0]
                shallow_rank.append(s["sess"])
                kept = True
            elif deep:
                snippet = _match_deep(s, q_lower) or ""
                if snippet:
                    matched_field = "transcript"
                    deep_hits += 1
                    deep_rank.append(s["sess"])
                    kept = True

        # Even if no lexical retriever matched, we may still keep the row
        # later if semantic put it in the top-N.
        if kept:
            title = s["ai_title"] or (s["first_user"][:60] if s["first_user"] else s["sess"][:8])
            title = title[:90]
            ws_match = sess_to_ws.get(s["sess"])
            row = {
                "sess": s["sess"],
                "title": title,
                "cwd": s["cwd"],
                "cwd_short": shorten_cwd(s["cwd"] or "(unknown)"),
                "cwd_exists": bool(s["cwd"]) and os.path.isdir(s["cwd"]),
                "age": humantime(s["mtime"]),
                "age_seconds": int(datetime.datetime.now().timestamp() - s["mtime"]),
                "n_msgs": s["n_msgs"],
                "kickoff": s["first_user"][:220],
                "latest_user": s["last_user"][:220],
                "latest_assistant": s["last_assistant"][:220],
                "active": s["sess"] in active_ids,
                "workspace_id": ws_match[0] if ws_match else "",
                "workspace_title": ws_match[1] if ws_match else "",
                "hidden": is_hidden,
                "matched_field": matched_field,
                "snippet": snippet,
            }
            out.append(row)
            by_sess[s["sess"]] = row

    # Semantic adds: any top-ranked session that wasn't already a lexical hit
    # gets pulled in with matched_field="semantic" so the UI can label it.
    if semantic_used and q_lower:
        for sess_id in semantic_ranks:
            if sess_id in by_sess:
                continue
            # Find the corresponding session payload
            src = next((x for x in sessions if x["sess"] == sess_id), None)
            if not src:
                continue
            if not include_hidden and src["sess"] in hidden_ids:
                continue
            title = src["ai_title"] or (src["first_user"][:60] if src["first_user"] else src["sess"][:8])
            title = title[:90]
            ws_match = sess_to_ws.get(src["sess"])
            row = {
                "sess": src["sess"],
                "title": title,
                "cwd": src["cwd"],
                "cwd_short": shorten_cwd(src["cwd"] or "(unknown)"),
                "cwd_exists": bool(src["cwd"]) and os.path.isdir(src["cwd"]),
                "age": humantime(src["mtime"]),
                "age_seconds": int(datetime.datetime.now().timestamp() - src["mtime"]),
                "n_msgs": src["n_msgs"],
                "kickoff": src["first_user"][:220],
                "latest_user": src["last_user"][:220],
                "latest_assistant": src["last_assistant"][:220],
                "active": src["sess"] in active_ids,
                "workspace_id": ws_match[0] if ws_match else "",
                "workspace_title": ws_match[1] if ws_match else "",
                "hidden": src["sess"] in hidden_ids,
                "matched_field": "semantic",
                "snippet": "",
            }
            out.append(row)
            by_sess[src["sess"]] = row
            semantic_only_added.add(src["sess"])

    # Fuse rankings with RRF when a query is active and we have at least one
    # ranked retriever. With only a single retriever (lexical-only mode) we
    # leave the existing mtime-newest order alone — RRF on a single ranking
    # would just reproduce that ranking anyway.
    if q_lower and (semantic_used or len(shallow_rank) + len(deep_rank) > 1):
        rankings = [r for r in (shallow_rank, deep_rank, semantic_ranks) if r]
        fused = _rrf_fuse(rankings)
        # Sort `out` by fused score desc; sessions absent from fused dict go last
        # in their original (mtime-newest) order.
        out.sort(key=lambda row: (-fused.get(row["sess"], 0.0), row.get("age_seconds", 0)))

    return {
        "generated_at": datetime.datetime.now().isoformat(timespec="seconds"),
        "sessions": out,
        "workspaces": workspaces_list,
        "hidden_count": hidden_count,
        "include_hidden": include_hidden,
        "query": query,
        "deep": deep,
        "deep_hits": deep_hits,
        "semantic_used": semantic_used,
        "semantic_provider": EMBED_PROVIDER if EMBED_PROVIDER != "off" else "",
        "semantic_error": semantic_error,
        "semantic_only_count": len(semantic_only_added),
        "semantic_pending": semantic_pending,
        "semantic_warming": _WARMER_BUSY,
        "semantic_indexed": semantic_indexed,
        "semantic_total": semantic_total,
        # Seconds-per-embedding the warmer measured on its last productive
        # pass. 0 until the warmer has done at least one pass with work to
        # do. UI uses this × pending to compute an ETA.
        "semantic_sec_per_embed": round(_WARMER_SEC_PER_EMBED, 4),
    }


def _sanitize_title(t):
    t = (t or "").strip()
    t = re.sub(r"\s+", " ", t)
    return t[:60] or "Claude session"


def _list_ws_refs_set():
    ws = live_workspaces()
    return {info.get("ref") for info in ws.values() if info.get("ref")}


def resume_in_new_workspace(session_id, cwd, title):
    """Create a new cmux workspace running `claude --resume <id>`, then rename it.
    Returns the new workspace ref (e.g. 'workspace:18') or raises."""
    if not cwd or not os.path.isdir(cwd):
        raise ValueError(f"cwd not usable: {cwd!r}")

    # Snapshot existing refs so we can detect which ref is new
    before = _list_ws_refs_set()

    cmd_str = f"claude --resume {shlex.quote(session_id)}"
    result = subprocess.run(
        [CMUX, "new-workspace", "--cwd", cwd, "--command", cmd_str],
        capture_output=True, text=True, timeout=5,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cmux new-workspace failed: {result.stderr or result.stdout}")

    # Parse 'OK workspace:NN' from stdout; fall back to diffing the workspace list
    new_ref = ""
    m = re.search(r"workspace:(\d+)", result.stdout or "")
    if m:
        new_ref = f"workspace:{m.group(1)}"
    else:
        # Fallback: poll for up to 2s
        for _ in range(20):
            after = _list_ws_refs_set()
            diff = after - before
            if diff:
                new_ref = next(iter(diff))
                break
            time.sleep(0.1)
    if not new_ref:
        raise RuntimeError("created workspace but could not determine its ref")

    # Rename
    safe_title = _sanitize_title(title)
    subprocess.run(
        [CMUX, "rename-workspace", "--workspace", new_ref, "--", safe_title],
        capture_output=True, text=True, timeout=5,
    )
    return new_ref


def _find_terminal_surface(workspace_id):
    """Return (surface_id, surface_ref) of a terminal surface in the given workspace.
    Prefers the selected surface; falls back to the first terminal surface."""
    try:
        out = subprocess.run(
            [CMUX, "--json", "--id-format", "both", "list-pane-surfaces",
             "--workspace", workspace_id],
            capture_output=True, text=True, timeout=3,
        )
        if out.returncode != 0:
            return None, None
        data = json.loads(out.stdout)
        surfaces = data.get("surfaces", []) or []
        terminal_surfaces = [s for s in surfaces if s.get("type") == "terminal"]
        if not terminal_surfaces:
            return None, None
        selected = next((s for s in terminal_surfaces if s.get("selected")), None)
        chosen = selected or terminal_surfaces[0]
        return chosen.get("id", ""), chosen.get("ref", "")
    except Exception:
        return None, None


def resume_in_existing_workspace(session_id, workspace_id):
    """Respawn the workspace's terminal surface with `claude --resume <id>`.
    Destructive — replaces pane contents. Does NOT rename the workspace:
    whatever name the workspace had is preserved (user chose that workspace
    for a reason)."""
    if not workspace_id:
        raise ValueError("workspace_id required")

    surface_id, surface_ref = _find_terminal_surface(workspace_id)
    if not surface_id:
        raise RuntimeError("workspace has no terminal surface to respawn into")

    cmd_str = f"claude --resume {shlex.quote(session_id)}"
    result = subprocess.run(
        [CMUX, "respawn-pane",
         "--workspace", workspace_id,
         "--surface", surface_id,
         "--command", cmd_str],
        capture_output=True, text=True, timeout=5,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cmux respawn-pane failed: {result.stderr or result.stdout}")

    # Focus the workspace so the user ends up looking at the new session
    subprocess.run(
        [CMUX, "select-workspace", "--workspace", workspace_id],
        capture_output=True, text=True, timeout=5,
    )
    return workspace_id


