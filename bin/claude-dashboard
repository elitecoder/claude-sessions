  }
  .card:hover { border-color: var(--accent-dim); background: var(--bg-hover); }
  .card.active { border-color: var(--green-dim); background: linear-gradient(180deg, var(--green-fill), transparent 80%), var(--bg-card); }
  .card.is-hidden { opacity: 0.45; filter: saturate(0.5); }
  .card.is-hidden:hover { opacity: 0.75; }
  .card { position: relative; overflow: visible; }
