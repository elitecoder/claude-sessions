  <span class="dot"></span>
  <span id="refresh-pill-label">Next refresh in 10s</span>
</div>
<div class="toast" id="toast"></div>
<script>
const grid = document.getElementById('grid');
const countEl = document.getElementById('session-count');
const tsEl = document.getElementById('refresh-ts');
const toast = document.getElementById('toast');
const searchWrap = document.getElementById('search');
const searchInput = document.getElementById('search-input');
const searchClear = document.getElementById('search-clear');
const semanticStatus = document.getElementById('semantic-status');
const semanticStatusText = document.getElementById('semantic-status-text');
const indexWarning = document.getElementById('index-warning');
const indexWarningText = document.getElementById('index-warning-text');
const indexWaitBtn = document.getElementById('index-wait');

indexWaitBtn.addEventListener('click', async () => {
  // Block on a sync reindex. The endpoint already exists for the CLI; we just
  // call it and show progress while it runs. Once it returns, refresh()
  // reruns the current query against the now-complete index.
  const prevLabel = indexWaitBtn.textContent;
  indexWaitBtn.disabled = true;
  indexWaitBtn.textContent = 'Indexing…';
  try {
    const r = await fetch('/api/embed/reindex', {method: 'POST'});
    if (!r.ok) throw new Error((await r.json()).error || r.statusText);
    await refresh();
    showToast('Index complete — semantic ranking now covers every session.', 'success');
  } catch (e) {
    showToast('Reindex failed: ' + e.message, 'error');
  } finally {
    indexWaitBtn.disabled = false;
    indexWaitBtn.textContent = prevLabel;
  }
});

function showToast(msg, kind) {
  toast.textContent = msg;
  toast.className = 'toast visible ' + (kind || '');
  setTimeout(() => { toast.className = 'toast'; }, 3200);
}

let cachedWorkspaces = [];
// Preserve dropdown picks across the 10s refresh cycle.
// Keyed by session_id → selected workspace_id (empty string = "New workspace").
const selectionState = new Map();
// "Show hidden" toggle (in-memory; doesn't persist across page reloads)
let showHidden = false;

// Current search query (lowercased). Empty string = no filter.
let searchQuery = '';
// Cache of the latest unfiltered payload so typing doesn't need to refetch.
let lastPayload = null;
// Deep-search results: session_id -> {snippet, matched_field}. Populated only
// when the shallow client-side filter returned 0 hits.
let deepHits = new Map();
// Latest deep-search query string so we can ignore stale responses.
let deepQueryInFlight = '';
// The query we've already attempted a deep search for (whether it returned
// hits or not). Prevents re-firing the server roundtrip on each keystroke.
let deepQueryAttempted = '';

function renderCards(data) {
  tsEl.textContent = new Date().toLocaleTimeString();
  // Always update the indexing pill + warning to match what's on screen,
  // including local-only re-renders that don't go through refresh().
  applySemanticStatus(data);
  cachedWorkspaces = data.workspaces || [];
  // Prune stale selections — if a workspace was closed between refreshes,
  // drop the selection so the card falls back to "New workspace".
  const liveWsIds = new Set(cachedWorkspaces.map(w => w.id));
  for (const [sid, wsId] of selectionState) {
    if (wsId && !liveWsIds.has(wsId)) selectionState.delete(sid);
  }
  if (!data.sessions.length) {
    grid.innerHTML = '<div class="empty">No Claude sessions found.</div>';
    countEl.textContent = 0;
    return;
  }

  // Client-side filter. Runs on every render so it applies after each 10s
  // refresh too. Matches title, kickoff, last prompt, last reply, and cwd.
  const q = searchQuery;
  const showing = [];
  // When semantic ranking ran, the server already returned a fused ordering
  // that includes semantic-only hits — trust it; just attach any snippets we
  // collected from a separate deep call.
  if (q && data.semantic_used) {
    for (const s of data.sessions) {
      const deep = deepHits.get(s.sess);
      showing.push(deep
        ? {...s, _deepSnippet: deep.snippet, _matchedField: deep.matched_field || s.matched_field}
        : {...s});
    }
  } else {
  for (const s of data.sessions) {
    if (!q) { showing.push(s); continue; }
    const hay = [
      s.title || '',
      s.kickoff || '',
      s.latest_user || '',
      s.latest_assistant || '',
      s.cwd || '',
    ].join('  ').toLowerCase();
    const idx = hay.indexOf(q);
    if (idx >= 0) {
      showing.push({...s, _matchedShallow: true});
      continue;
    }
    const deep = deepHits.get(s.sess);
    if (deep) {
      showing.push({...s, _deepSnippet: deep.snippet, _matchedField: deep.matched_field});
    }
  }
  }
  countEl.textContent = showing.length + (q ? ' / ' + data.sessions.length : '');

  if (!showing.length) {
    const msg = q
      ? (deepQueryInFlight === q
          ? 'Searching full transcripts for “' + escapeHtml(q) + '”…'
          : 'No matches for “' + escapeHtml(q) + '”.')
      : 'No Claude sessions found.';
    grid.innerHTML = '<div class="empty">' + msg + '</div>';
    // If we have a query but nothing matched shallow and deep isn't in flight,
    // trigger a deep search. It's idempotent — if we already tried, the
    // deepHits map will be populated (even if empty).
    if (q && deepQueryAttempted !== q && deepQueryInFlight !== q) {
      runDeepSearch(q);
    }
    return;
  }
  // Update hidden-count chip in header
  const hidEl = document.getElementById('hidden-toggle');
  const hidCount = document.getElementById('hidden-count');
  hidCount.textContent = data.hidden_count || 0;
  if (data.hidden_count > 0) {
    hidEl.style.display = '';
    hidEl.textContent = '';
    hidEl.appendChild(document.createTextNode(showHidden ? 'Hide hidden (' : 'Show hidden ('));
    const span = document.createElement('span');
    span.id = 'hidden-count';
    span.textContent = data.hidden_count;
    hidEl.appendChild(span);
    hidEl.appendChild(document.createTextNode(')'));
    hidEl.classList.toggle('active', showHidden);
  } else {
    hidEl.style.display = 'none';
    showHidden = false;
  }

  const frag = document.createDocumentFragment();
  for (const s of showing) {
    const card = document.createElement('div');
    const semanticOnly = s.matched_field === 'semantic' && !s._matchedShallow && !s._deepSnippet;
    card.className = 'card'
      + (s.active ? ' active' : '')
      + (s.hidden ? ' is-hidden' : '')
      + (semanticOnly ? ' semantic-only' : '');
    // Hide (×) button — only for non-hidden cards; hidden cards get a Restore button in actions row
    if (!s.hidden) {
      const hideBtn = document.createElement('button');
      hideBtn.className = 'hide-btn';
      hideBtn.textContent = '×';
      hideBtn.title = 'Hide from dashboard (session data is preserved)';
      hideBtn.onclick = (e) => { e.stopPropagation(); hideCard(s, card); };
      card.appendChild(hideBtn);
    }

    const titleRow = document.createElement('div');
    titleRow.className = 'title-row';
    const title = document.createElement('div');
    title.className = 'title';
    if (searchQuery) {
      title.innerHTML = hilite(s.title);
    } else {
      title.textContent = s.title;
    }
    titleRow.appendChild(title);
    const status = document.createElement('span');
    status.className = 'status';
    status.textContent = s.active ? 'running' : 'idle';
    if (s.active && s.workspace_title) status.title = 'Workspace: ' + s.workspace_title;
    titleRow.appendChild(status);
    card.appendChild(titleRow);

    const meta = document.createElement('div');
    meta.className = 'meta';
    const cwd = document.createElement('span');
    cwd.className = 'cwd' + (s.cwd_exists ? '' : ' missing');
    cwd.textContent = s.cwd_short || '(unknown cwd)';
    meta.appendChild(cwd);
    const age = document.createElement('span');
    age.textContent = s.age + ' ago · ' + s.n_msgs + ' msgs';
    meta.appendChild(age);
    if (s.active && s.workspace_title) {
      const ws = document.createElement('span');
      ws.className = 'ws-name';
      ws.textContent = '↳ ' + s.workspace_title;
      ws.title = s.workspace_title;
      meta.appendChild(ws);
    }
    card.appendChild(meta);

    const preview = document.createElement('div');
    preview.className = 'preview';
    if (s.kickoff) {
      const p = document.createElement('p');
      p.innerHTML = '<b>kickoff</b>' + hilite(s.kickoff);
      preview.appendChild(p);
    }
    if (s.latest_user && s.latest_user !== s.kickoff) {
      const p = document.createElement('p');
      p.innerHTML = '<b>last prompt</b>' + hilite(s.latest_user);
      preview.appendChild(p);
    }
    if (s.latest_assistant) {
      const p = document.createElement('p');
      p.innerHTML = '<b>last reply</b>' + hilite(s.latest_assistant);
      preview.appendChild(p);
    }
    // Deep-search hit: show the transcript snippet in its own styled row so
    // it's obvious this match came from the body, not the preview fields.
    if (s._deepSnippet) {
      const hit = document.createElement('div');
      hit.className = 'match-hit';
      hit.innerHTML = '<span class="label">match · transcript</span>' + hilite(s._deepSnippet);
      preview.appendChild(hit);
    }
    // Semantic-only hit: no lexical match anywhere, but the embedding
    // ranked it close to the query. Label it explicitly so the user
    // knows why it's here.
    if (semanticOnly) {
      const hit = document.createElement('div');
      hit.className = 'match-hit semantic';
      hit.innerHTML = '<span class="label">match · semantic</span>'
        + 'Embedding similarity to your query — no exact word match.';
      preview.appendChild(hit);
    }
    card.appendChild(preview);

    const actions = document.createElement('div');
    actions.className = 'actions';

    const select = document.createElement('select');
    const newOpt = document.createElement('option');
    newOpt.value = '';
    newOpt.textContent = '↗ New workspace';
    select.appendChild(newOpt);
    for (const w of cachedWorkspaces) {
      // Don't offer to respawn the workspace where this same session is running (no-op)
      if (w.id === s.workspace_id) continue;
      const opt = document.createElement('option');
      opt.value = w.id;
      const lbl = w.title.length > 28 ? w.title.slice(0, 27) + '…' : w.title;
      opt.textContent = (w.has_claude ? '⚠ ' : '→ ') + lbl;
      opt.title = w.title + (w.has_claude ? ' (has a Claude session — will be replaced)' : '');
      select.appendChild(opt);
    }
    // Restore previously-picked workspace across refreshes
    const savedPick = selectionState.get(s.sess);
    if (savedPick && [...select.options].some(o => o.value === savedPick)) {
      select.value = savedPick;
    }
    select.disabled = s.active || !s.cwd_exists;

    const btn = document.createElement('button');
    btn.className = 'primary';
    btn.disabled = s.active || !s.cwd_exists;

    function updateButton() {
      if (s.active) { btn.textContent = 'Already running'; return; }
      if (!s.cwd_exists && !select.value) { btn.textContent = 'cwd missing'; return; }
      if (!select.value) {
        btn.textContent = 'Resume in new workspace';
        btn.className = 'primary';
      } else {
        const w = cachedWorkspaces.find(x => x.id === select.value);
        const titleTxt = w ? w.title : '(workspace)';
        if (w && w.has_claude) {
          btn.textContent = '⚠ Replace “' + titleTxt + '”';
          btn.className = 'danger';
        } else {
          btn.textContent = 'Resume in “' + titleTxt + '”';
          btn.className = 'primary';
        }
      }
    }
    select.onchange = () => {
      selectionState.set(s.sess, select.value);
      updateButton();
    };
    updateButton();
    btn.onclick = () => resumeSession(s, btn, select.value);

    actions.appendChild(select);
    actions.appendChild(btn);

    if (s.hidden) {
      const restoreBtn = document.createElement('button');
      restoreBtn.textContent = '↺ Restore';
      restoreBtn.onclick = () => unhideCard(s);
      actions.appendChild(restoreBtn);
    }

    card.appendChild(actions);

    frag.appendChild(card);
  }
  grid.replaceChildren(frag);
}

function escapeHtml(s) {
  return (s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// Escape a string for safe literal use in a RegExp.
function regexEscape(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

// Escape text for HTML, then wrap case-insensitive occurrences of searchQuery
// in <mark class="qhit">. Returns safe HTML.
function hilite(text) {
  const esc = escapeHtml(text || '');
  if (!searchQuery) return esc;
  const pat = new RegExp('(' + regexEscape(escapeHtml(searchQuery)) + ')', 'gi');
  return esc.replace(pat, '<mark class="qhit">$1</mark>');
}

// Run the deep (server-side) transcript search. Only fires when the shallow
// filter returned nothing, and at most once per distinct query.
async function runDeepSearch(q) {
  deepQueryInFlight = q;
  searchWrap.classList.add('searching');
  try {
    const url = '/api/sessions?q=' + encodeURIComponent(q)
      + '&deep=1'
      + (showHidden ? '&include_hidden=1' : '');
    const r = await fetch(url);
    const data = await r.json();
    // If the user kept typing, this response is stale — drop it.
    if (searchQuery !== q) return;
    deepHits = new Map();
    for (const s of (data.sessions || [])) {
      if (s.snippet) {
        deepHits.set(s.sess, {snippet: s.snippet, matched_field: s.matched_field});
      }
    }
    deepQueryAttempted = q;
    if (lastPayload) renderCards(lastPayload);
  } catch (e) {
    console.error('deep search failed', e);
  } finally {
    if (deepQueryInFlight === q) deepQueryInFlight = '';
    searchWrap.classList.remove('searching');
  }
}

// Debounced search-box handler.
let searchDebounce = null;
function onSearchInput() {
  const raw = searchInput.value.trim();
  const next = raw.toLowerCase();
  searchWrap.classList.toggle('has-query', !!next);
  if (next === searchQuery) return;
  searchQuery = next;
  // New query resets deep state — previous hits aren't valid any more.
  deepHits = new Map();
  deepQueryAttempted = '';
  deepQueryInFlight = '';
  clearTimeout(searchDebounce);
  searchDebounce = setTimeout(() => {
    // When a semantic provider is configured, every keystroke needs a fresh
    // server-side ranking (one Ollama call to embed the query + cosine over
    // the cached vectors — ~300 ms on warm cache). When semantic is off,
    // re-rendering the cached payload locally gives instant feedback and the
    // next 10 s poll catches any new sessions.
    const semanticOn = !!(lastPayload && lastPayload.semantic_provider);
    if (semanticOn && searchQuery) {
      refresh();
    } else if (lastPayload) {
      renderCards(lastPayload);
    }
  }, 250);
}
searchInput.addEventListener('input', onSearchInput);
searchInput.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    searchInput.value = '';
    onSearchInput();
    searchInput.blur();
  }
});
searchClear.addEventListener('click', () => {
  searchInput.value = '';
  onSearchInput();
  searchInput.focus();
});

// ⌘K / Ctrl+K / "/" focuses the search box.
document.addEventListener('keydown', (e) => {
  if (document.activeElement === searchInput) return;
  const isMod = e.metaKey || e.ctrlKey;
  if ((isMod && e.key.toLowerCase() === 'k') || (!isMod && e.key === '/')) {
    e.preventDefault();
    searchInput.focus();
    searchInput.select();
  }
});

async function resumeSession(s, btn, targetWorkspaceId) {
  if (targetWorkspaceId) {
    const w = cachedWorkspaces.find(x => x.id === targetWorkspaceId);
    if (w && w.has_claude) {
      const ok = confirm(
        'Workspace “' + w.title + '” already has a Claude session running.\n\n' +
        'Continuing will kill that pane and replace it with “' + s.title + '”.\n\n' +
        'Proceed?'
      );
      if (!ok) return;
    }
  }
  const prevLabel = btn.textContent;
  btn.disabled = true;
  btn.textContent = targetWorkspaceId ? 'Respawning pane…' : 'Creating workspace…';
  try {
    const r = await fetch('/api/resume', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        session_id: s.sess,
        title: s.title,
        cwd: s.cwd,
        workspace_id: targetWorkspaceId || '',
      }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || r.statusText);
    if (data.mode === 'existing') {
      const label = data.title ? '"' + data.title + '"' : 'existing workspace';
      showToast('Resumed in ' + label, 'success');
      btn.textContent = 'Resumed in ' + (data.title ? '"' + data.title + '"' : 'existing');
      // Clear the picked selection for this card — we're done with it
      selectionState.delete(s.sess);
    } else {
      showToast('Opened workspace ' + data.workspace_ref + ' · ' + data.title, 'success');
      btn.textContent = 'Opened · ' + data.workspace_ref;
    }
    setTimeout(refresh, 600);
  } catch (e) {
    showToast('Resume failed: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = prevLabel;
  }
}

const REFRESH_MS = 10000;
const pill = document.getElementById('refresh-pill');
const pillLabel = document.getElementById('refresh-pill-label');
let lastRefreshAt = 0;
let refreshInFlight = false;

async function refresh() {
  if (refreshInFlight) return;
  refreshInFlight = true;
  pill.classList.add('refreshing');
  pillLabel.textContent = 'Refreshing…';
  try {
    // The query is included on every poll when one is active so the server
    // can run semantic ranking automatically (whenever its provider is
    // configured). Lexical-only mode just sends include_hidden — the server
    // returns the full session list and the client filters it.
    const params = [];
    if (showHidden) params.push('include_hidden=1');
    if (searchQuery) {
      params.push('q=' + encodeURIComponent(searchQuery));
      params.push('deep=1');
    }
    const url = '/api/sessions' + (params.length ? '?' + params.join('&') : '');
    const r = await fetch(url);
    const data = await r.json();
    // Stale-response guard: only apply if user hasn't kept typing past us.
    if (searchQuery && data.query && data.query.toLowerCase() !== searchQuery) {
      return;
    }
    lastPayload = data;
    if (data.semantic_error) {
      showToast('Semantic backend error: ' + data.semantic_error, 'error');
    }
    renderCards(data);
    lastRefreshAt = Date.now();
  } catch (e) {
    console.error(e);
  } finally {
    refreshInFlight = false;
    pill.classList.remove('refreshing');
  }
}

// Status pill: visible only while indexing work is pending. Shows progress
// (N/M) and an honest ETA when the warmer has measured throughput at least
// once. Hidden in steady state.
function applySemanticStatus(data) {
  const provider = (data && data.semantic_provider) || '';
  const pending = data ? (data.semantic_pending || 0) : 0;
  const warming = data ? data.semantic_warming : false;
  const indexed = data ? (data.semantic_indexed || 0) : 0;
  const total = data ? (data.semantic_total || 0) : 0;
  const sec = data ? (data.semantic_sec_per_embed || 0) : 0;
  if (!provider || (!pending && !warming)) {
    semanticStatus.classList.remove('visible');
  } else {
    semanticStatus.classList.add('visible');
    let txt = 'Indexing ' + indexed + '/' + total;
    if (sec > 0 && pending > 0) {
      txt += ' · ' + formatEta(pending * sec);
    } else if (pending > 0) {
      // No throughput sample yet — fall back to a vague hint instead of
      // making up a number.
      txt += ' · estimating…';
    }
    semanticStatusText.textContent = txt;
  }
  applyIndexWarning(data);
}

// Inline warning under the search bar. Visible only when the user has a
// query active AND some sessions still aren't in the semantic index. The
// "Wait for full index" button blocks on a sync reindex and re-runs the
// search once everything is indexed.
function applyIndexWarning(data) {
  const provider = (data && data.semantic_provider) || '';
  const pending = data ? (data.semantic_pending || 0) : 0;
  const total = data ? (data.semantic_total || 0) : 0;
  if (!provider || !searchQuery || !pending || !total) {
    indexWarning.classList.remove('visible');
    return;
  }
  const sec = data.semantic_sec_per_embed || 0;
  const eta = sec > 0 ? ' (~' + formatEta(pending * sec) + ' to finish)' : '';
  indexWarningText.textContent =
    'Semantic ranking is missing ' + pending + ' of ' + total
    + ' sessions' + eta + '. Lexical results below are complete; the missing sessions could only be reached via embedding similarity.';
  indexWarning.classList.add('visible');
}

function formatEta(seconds) {
  if (!isFinite(seconds) || seconds < 0) return '';
  if (seconds < 1.5) return 'about 1s';
  if (seconds < 60) return Math.round(seconds) + 's';
  const m = Math.floor(seconds / 60);
  const s = Math.round(seconds % 60);
  if (m < 10) return m + 'm ' + s + 's';
  return m + 'm';
}

async function hideCard(s, cardEl) {
  // Optimistic fade-out
  if (cardEl) {
    cardEl.style.transition = 'opacity 180ms';
    cardEl.style.opacity = '0.1';
  }
  try {
    const r = await fetch('/api/hide', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({session_id: s.sess}),
    });
    if (!r.ok) throw new Error((await r.json()).error || r.statusText);
    // Undo toast — keep it up for 6s
    showUndoToast(s);
    refresh();
  } catch (e) {
    showToast('Hide failed: ' + e.message, 'error');
    if (cardEl) cardEl.style.opacity = '';
  }
}

async function unhideCard(s) {
  try {
    const r = await fetch('/api/unhide', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({session_id: s.sess}),
    });
    if (!r.ok) throw new Error((await r.json()).error || r.statusText);
    showToast('Restored: ' + s.title, 'success');
    refresh();
  } catch (e) {
    showToast('Restore failed: ' + e.message, 'error');
  }
}

function showUndoToast(s) {
  toast.innerHTML = '';
  const span = document.createElement('span');
  span.textContent = 'Hidden: ' + (s.title || 'session') + '  ';
  const a = document.createElement('a');
  a.textContent = 'Undo';
  a.href = '#';
  a.style.cssText = 'color: var(--accent); margin-left: 6px; text-decoration: underline; cursor: pointer;';
  a.onclick = (e) => {
    e.preventDefault();
    unhideCard(s);
    toast.className = 'toast';
  };
  toast.appendChild(span);
  toast.appendChild(a);
  toast.className = 'toast visible';
  clearTimeout(showUndoToast._t);
  showUndoToast._t = setTimeout(() => { toast.className = 'toast'; }, 6000);
}

document.getElementById('hidden-toggle').addEventListener('click', () => {
  showHidden = !showHidden;
  refresh();
});

function tickPill() {
  if (refreshInFlight) return;
  const elapsed = Date.now() - lastRefreshAt;
  const remaining = Math.max(0, Math.ceil((REFRESH_MS - elapsed) / 1000));
  pillLabel.textContent = remaining > 0 ? `Next refresh in ${remaining}s` : 'Refreshing…';
}

pill.addEventListener('click', () => refresh());

refresh();
setInterval(refresh, REFRESH_MS);
setInterval(tickPill, 250);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        # Quiet noisy access log; write errors only
        if "POST /api/resume" in (fmt % args):
            sys.stderr.write("[%s] %s\n" % (self.log_date_time_string(), fmt % args))

    def _send_json(self, status, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/?"):
            body = DASHBOARD_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if self.path == "/api/sessions" or self.path.startswith("/api/sessions?"):
            try:
                from urllib.parse import urlparse, parse_qs
                qs = parse_qs(urlparse(self.path).query)
                include_hidden = qs.get("include_hidden", ["0"])[0] in ("1", "true", "yes")
                query = qs.get("q", [""])[0]
                deep = qs.get("deep", ["0"])[0] in ("1", "true", "yes")
                payload = build_payload(include_hidden=include_hidden, query=query, deep=deep)
                self._send_json(200, payload)
            except Exception as e:
                traceback.print_exc()
                self._send_json(500, {"error": str(e)})
            return
        if self.path == "/healthz":
            self._send_json(200, {"ok": True, "port": PORT})
            return
        self._send_json(404, {"error": "not found"})

    def do_POST(self):
        if self.path not in (
            "/api/resume", "/api/hide", "/api/unhide",
            "/api/embed/reindex", "/api/embed/evict",
        ):
            self._send_json(404, {"error": "not found"})
            return
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b"{}"
        try:
            data = json.loads(body)
        except Exception:
            self._send_json(400, {"error": "invalid JSON"})
            return

        if self.path == "/api/hide":
            sid = data.get("session_id")
            if not sid:
                self._send_json(400, {"error": "session_id required"})
                return
            count = hide_session(sid)
            self._send_json(200, {"hidden_count": count})
            return

        if self.path == "/api/unhide":
            sid = data.get("session_id")
            if not sid:
                self._send_json(400, {"error": "session_id required"})
                return
            count = unhide_session(sid)
            self._send_json(200, {"hidden_count": count})
            return

        if self.path == "/api/embed/reindex":
            if EMBED_PROVIDER == "off":
                self._send_json(400, {"error": "no embed provider configured"})
                return
            try:
                sessions = collect_sessions()
                t0 = time.time()
                vecs = _ensure_session_embeddings(sessions, parallelism=8)
                self._send_json(200, {
                    "provider": EMBED_PROVIDER,
                    "sessions_total": len(sessions),
                    "embeddings": len(vecs),
                    "elapsed_seconds": round(time.time() - t0, 2),
                })
            except Exception as e:
                traceback.print_exc()
                self._send_json(500, {"error": str(e)})
            return

        if self.path == "/api/embed/evict":
            try:
                conn = _embed_db()
                with _EMBED_CONN_LOCK:
                    cur = conn.execute("SELECT COUNT(*) FROM embeddings")
                    before = cur.fetchone()[0]
                    conn.execute("DELETE FROM embeddings")
                    conn.commit()
                self._send_json(200, {"evicted": before})
            except Exception as e:
                traceback.print_exc()
                self._send_json(500, {"error": str(e)})
            return

        # /api/resume
        sid = data.get("session_id")
        cwd = data.get("cwd")
        title = data.get("title") or "Claude session"
        target_ws = data.get("workspace_id") or ""
        if not sid:
            self._send_json(400, {"error": "session_id required"})
            return
        try:
            if target_ws:
                # Look up the workspace's current title BEFORE respawning so
                # we can show the user which workspace they landed in.
                ws_live = live_workspaces()
                preserved_title = ws_live.get(target_ws, {}).get("title", "")
                ref = resume_in_existing_workspace(sid, target_ws)
                self._send_json(200, {
                    "mode": "existing",
                    "workspace_id": ref,
                    "title": preserved_title,
                })
            else:
                if not cwd:
                    self._send_json(400, {"error": "cwd required for new workspace"})
                    return
                ref = resume_in_new_workspace(sid, cwd, title)
                self._send_json(200, {
                    "mode": "new",
                    "workspace_ref": ref,
                    "title": _sanitize_title(title),
                })
        except Exception as e:
            traceback.print_exc()
            self._send_json(500, {"error": str(e)})


def main():
    # Start the embedding warmer in the background so semantic search is
    # ready by the time the user types a query (or, on cold install, ~25s
    # later for a 500-session corpus). No-op when no provider is configured.
    _start_warmer_if_configured()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"claude-dashboard listening on http://127.0.0.1:{PORT}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
