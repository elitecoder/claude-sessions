<body>
<header>
  <div class="header-row">
    <h1>Claude sessions</h1>
    <div class="search" id="search">
      <span class="icon">⌕</span>
      <input id="search-input" type="search" placeholder="Search titles, prompts, replies…" autocomplete="off" spellcheck="false">
      <button class="clear" id="search-clear" title="Clear (Esc)">×</button>
    </div>
    <span class="semantic-status" id="semantic-status" title="Embedding the rest of your sessions in the background. Lexical search keeps working — semantic ranking will start including these once they're indexed.">
      <span class="dot"></span><span id="semantic-status-text">Indexing…</span>
    </span>
    <div class="meta">
      <button class="hidden-toggle" id="hidden-toggle" style="display:none;">Show hidden (<span id="hidden-count">0</span>)</button>
      <span id="status-line"><span id="session-count">—</span> sessions · last refresh <span id="refresh-ts">—</span></span>
    </div>
  </div>
  <div class="index-warning" id="index-warning">
    <span id="index-warning-text"></span>
    <button id="index-wait" type="button">Wait for full index</button>
