#!/usr/bin/env python3
"""
cmux-resume — list recent Claude sessions, pick one, resume it in this terminal.

By default, sessions currently running in a live cmux workspace are HIDDEN
(they're already being used somewhere). Use --all to show everything.

Usage:
  cmux-resume                # interactive picker (top 30 by recency, active hidden)
  cmux-resume --all          # include currently-active sessions
  cmux-resume --list         # print only, no picker
  cmux-resume --limit 50     # show top N sessions
  cmux-resume --hours 6      # only sessions modified in last N hours

On pick: cd to the session's recorded cwd and exec `claude --resume <id>` in
the current terminal (replaces this process — no new cmux workspace is spawned).
"""
import argparse
import datetime
import glob
import json
import os
import shlex
import subprocess
import sys

SESSIONS_DIR = os.path.expanduser("~/.claude/projects")
REGISTRY = os.path.expanduser("~/.claude/cmux-registry.json")
CMUX = "/Applications/cmux.app/Contents/Resources/bin/cmux"
HOME = os.path.expanduser("~")


def _extract_user_text(j):
    if j.get("type") != "user":
        return None
    msg = j.get("message", {})
    c = msg.get("content")
    if isinstance(c, list):
        c = " ".join(
            x.get("text", "")
            for x in c
            if isinstance(x, dict) and x.get("type") == "text"
        )
    if not isinstance(c, str):
        return None
    s = c.strip()
    if not s or s.startswith("<"):
        return None
    return s


def _condense(text):
    lines = [ln.strip() for ln in text.splitlines()]
    lines = [ln for ln in lines if ln]
    while lines and (lines[0].startswith("#") or lines[0].lower() in ("## context", "context", "context:")):
        lines.pop(0)
    return " ".join(lines)


def parse_session(path):
    sess = os.path.basename(path)[:-6]
    cwd = ""
    first_user = ""
    last_user = ""
    last_user_ts = ""
    n_msgs = 0
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                try:
                    j = json.loads(line)
                except Exception:
                    continue
                n_msgs += 1
                if not cwd and j.get("cwd"):
                    cwd = j["cwd"]
                txt = _extract_user_text(j)
                if txt:
                    if not first_user:
                        first_user = _condense(txt)
                    last_user = _condense(txt)
                    ts = j.get("timestamp", "")
                    if ts:
                        last_user_ts = ts
    except Exception:
        pass
    return {
        "sess": sess,
        "path": path,
        "cwd": cwd or "(unknown)",
        "mtime": os.path.getmtime(path),
        "last_user_ts": last_user_ts,
        "first_user": first_user,
        "last_user": last_user,
        "n_msgs": n_msgs,
    }


def humantime(ts):
    delta = datetime.datetime.now().timestamp() - ts
    if delta < 60:
        return f"{int(delta)}s"
    if delta < 3600:
        return f"{int(delta/60)}m"
    if delta < 86400:
        return f"{int(delta/3600)}h"
    return f"{int(delta/86400)}d"


def shorten_cwd(cwd, width=42):
    short = cwd.replace(HOME, "~") if cwd.startswith(HOME) else cwd
    if len(short) > width:
        short = "…" + short[-(width - 1):]
    return short


def _active_session_ids():
    """Return set of session_ids currently registered to a LIVE cmux workspace.
    Dead workspaces are ignored so stale registry entries don't hide usable sessions."""
    try:
        with open(REGISTRY) as f:
            reg = json.load(f)
    except Exception:
        return set()
    if not reg:
        return set()
    try:
        out = subprocess.run(
            [CMUX, "--json", "--id-format", "both", "list-workspaces"],
            capture_output=True, text=True, timeout=2,
        )
        if out.returncode != 0 or not out.stdout.strip():
            return set()  # cmux unreachable — don't hide anything
        data = json.loads(out.stdout)
        items = data.get("workspaces") if isinstance(data, dict) else data
        live_ws = {w.get("id") or w.get("uuid") for w in (items or []) if isinstance(w, dict)}
    except Exception:
        return set()
    return {
        entry["session_id"]
        for ws, entry in reg.items()
        if ws in live_ws and entry.get("session_id")
    }


def collect_sessions(limit, hours, hide_active):
    cutoff = datetime.datetime.now().timestamp() - (hours * 3600) if hours else 0
    hidden = _active_session_ids() if hide_active else set()
    files = []
    skipped_active = 0
    for p in glob.glob(os.path.join(SESSIONS_DIR, "*", "*.jsonl")):
        if "/subagents/" in p:
            continue
        if hours and os.path.getmtime(p) < cutoff:
            continue
        sess = os.path.basename(p)[:-6]
        if sess in hidden:
            skipped_active += 1
            continue
        files.append(p)
    files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    files = files[:limit]
    return [parse_session(p) for p in files], skipped_active


def _term_width():
    try:
        return max(80, os.get_terminal_size().columns)
    except OSError:
        return 100


def render(sessions):
    if not sessions:
        print("No sessions found.")
        return
    width = _term_width()
    body_width = width - 14
    print()
    for i, s in enumerate(sessions, 1):
        warn = "" if os.path.isdir(s["cwd"]) else " ⚠"
        cwd = shorten_cwd(s["cwd"]) + warn
        header = f"[{i:>2}]  {humantime(s['mtime']):>4} ago  {s['n_msgs']:>5} msgs   {cwd}"
        print(header)
        kick = s["first_user"][:body_width].rstrip()
        last = s["last_user"][:body_width].rstrip()
        if kick == last:
            print(f"      only msg : {kick}")
        else:
            print(f"      kickoff  : {kick}")
            print(f"      latest   : {last}")
        print()


def resume(s):
    if not os.path.isdir(s["cwd"]):
        print(f"⚠  cwd {s['cwd']} no longer exists.")
        ans = input("Resume from current cwd instead? [y/N]: ").strip().lower()
        if ans != "y":
            return
        cwd = os.getcwd()
    else:
        cwd = s["cwd"]

    shell = os.environ.get("SHELL", "/bin/zsh")
    cmd = f"cd {shlex.quote(cwd)} && claude --resume {shlex.quote(s['sess'])}"
    print(f"$ {cmd}\n")
    sys.stdout.flush()
    os.execvp(shell, [shell, "-ic", cmd])


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", action="store_true", help="print only, do not prompt")
    ap.add_argument("--all", action="store_true", help="include currently-active sessions")
    ap.add_argument("--limit", type=int, default=30, help="max sessions to show (default: 30)")
    ap.add_argument("--hours", type=float, default=0, help="only sessions modified in last N hours")
    args = ap.parse_args()

    sessions, skipped = collect_sessions(args.limit, args.hours, hide_active=not args.all)
    if skipped:
        print(f"(hiding {skipped} active session(s); use --all to show)")
    render(sessions)

    if args.list or not sessions:
        return

    try:
        pick = input("Pick # to resume (q to quit): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if not pick or pick.lower() == "q":
        return
    try:
        idx = int(pick) - 1
    except ValueError:
        print("Not a number.")
        sys.exit(1)
    if not (0 <= idx < len(sessions)):
        print("Out of range.")
        sys.exit(1)

    resume(sessions[idx])


if __name__ == "__main__":
    main()
